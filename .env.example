# =============================================================================
# Proxmox Manager — deployment environment
# Copy to .env and replace every change-me-* value before starting.
#   cp .env.example .env
# =============================================================================

# Image tag (default: latest)
IMAGE_TAG=latest

# Published host ports
FRONTEND_PORT=3000
BACKEND_PORT=5000

# PostgreSQL
POSTGRES_DB=proxmox-manager
POSTGRES_USER=proxmox-manager
# Prefer letters/numbers/_/- only. If you use @ : / # ? & etc., you MUST URL-encode
# them in DATABASE_URL below (e.g. @ -> %40).
POSTGRES_PASSWORD=change-me-strong-password

# Full Prisma/Postgres URL used by the backend (host must stay "db" on this Compose network).
# Example with encoded @ in password "Pr0xm0x@Pp":
# DATABASE_URL=postgresql://proxmox-manager:Pr0xm0x%40Pp@db:5432/proxmox-manager?schema=public
DATABASE_URL=postgresql://proxmox-manager:change-me-strong-password@db:5432/proxmox-manager?schema=public

# Public URLs (how browsers reach the app)
# If you deploy behind a domain / reverse proxy, set these to https://your-domain
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Backend secrets — generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-string
ENCRYPTION_KEY=change-me-64-char-hex-string
SODIUM_SECRET_KEY=change-me-64-char-hex-string
